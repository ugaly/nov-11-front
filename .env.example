# Copy to `.env.local` for local dev (never commit secrets).
# Production build uses `.env.production` → https://api.companies.co.tz

# Spring Boot API (see server.port in application.yml). No trailing slash.
# Local:
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:9092
# Production (also set in `.env.production` and Docker build ARG):
# NEXT_PUBLIC_API_BASE_URL=https://api.companies.co.tz

# SMTP — manual form email (Gmail: use App Password, not account password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
MAIL_FROM=your-email@gmail.com
